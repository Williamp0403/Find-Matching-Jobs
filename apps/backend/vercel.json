{
  "version": 2,
  "buildCommand": "pnpm --filter @find-matching-jobs/types build && npx nest build",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/jobs/cron-sync",
      "schedule": "0 0 * * 0"
    }
  ]
}
